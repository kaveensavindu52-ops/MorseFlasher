{
  "expo": {
    "name": "Morse Flasher Pro",
    "slug": "MorseFlasher",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.kaveen.morseflasher",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.FLASHLIGHT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Morse Flasher Pro to access your camera to control the flashlight."
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "5b9a94d4-4928-43e2-bbe3-3e3a64b7b46a"
      }
    }
  }
}
